[146.996, "o", "\u001b[90m┌─ README.md · stack y publicación ─────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[146.996, "o", "\u001b[90m  20\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00mHTML, CSS y JavaScript sin build step.\u001b[90m\u001b[39;49;00m\n"]
[147.051, "o", "\u001b[90m  21\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00mTipografías Space Grotesk, Inter y JetBrains Mono.\u001b[90m\u001b[39;49;00m\n"]
[147.106, "o", "\u001b[90m  22\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00mDiseño oscuro responsive, animaciones de entrada y tarjetas por proyecto.\u001b[90m\u001b[39;49;00m\n"]
[147.161, "o", "\u001b[90m  23\u001b[0m\u001b[90m │ \u001b[0m\u001b[94m-\u001b[39;49;00m\u001b[90m \u001b[39;49;00mGitHub Pages sirviendo desde \u001b[33m`main`\u001b[39;49;00m en la raíz del repositorio.\u001b[90m\u001b[39;49;00m\n"]
[147.216, "o", "\u001b[90m└───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
